<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/window_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Big Round Button -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnToggleService"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:background="@drawable/round_button"
                    android:text="@string/start_service"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textAllCaps="true"
                    android:elevation="8dp"
                    android:stateListAnimator="@null"/>
            </FrameLayout>

            <!-- SETTINGS Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_header"
                android:textColor="@color/brand_teal"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingBottom="8dp"/>

            <!-- Settings List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <!-- Scan QR Code Action Card -->
                <LinearLayout
                    android:id="@+id/layoutScanQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_item_single"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_qr_code"
                        app:tint="@color/brand_teal"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/scan_qr_code_title"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/scan_qr_code_desc"
                            android:textColor="@color/text_subtitle"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 1. Connection Mode -->
                <LinearLayout
                    android:id="@+id/layoutConnectionMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_item_top"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/connection_mode_label"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="normal"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvConnectionModeValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_nsd"
                        android:textColor="@color/text_subtitle"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- 1b. Force Stop Hotspot (Only shown if mode 1) -->
                <LinearLayout
                    android:id="@+id/layoutHotspotForceStop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_item_middle"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hotspot_force_stop_title"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hotspot_force_stop_desc"
                            android:textColor="@color/text_subtitle"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchHotspotForceStop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"/>
                </LinearLayout>

                <!-- 1a. Static IP (Hidden by default, shown if mode 2) -->
                <LinearLayout
                    android:id="@+id/layoutStaticIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_item_middle"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/static_ip_label"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="normal"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvStaticIpValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/not_set"
                        android:textColor="@color/text_subtitle"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- 2. WiFi Direct Name (Hidden by default, shown if mode 3) -->
                <LinearLayout
                    android:id="@+id/layoutWifiDirectName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_item_middle"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wifi_direct_name_label"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="normal"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvWifiDirectNameValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/not_set"
                        android:textColor="@color/text_subtitle"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- 3. Auto Start -->
                <LinearLayout
                    android:id="@+id/layoutAutoStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_item_middle"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_start_label"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="normal"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvAutoStartValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_start_no"
                        android:textColor="@color/text_subtitle"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- 4. Bluetooth Device -->
                <LinearLayout
                    android:id="@+id/layoutBluetoothDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_item_middle"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_device_label"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="normal"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvBluetoothDeviceValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/not_set"
                        android:textColor="@color/text_subtitle"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- 4a. Bluetooth Auto Reconnect -->
                <LinearLayout
                    android:id="@+id/layoutBtAutoReconnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_item_middle"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bt_auto_reconnect_title"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bt_auto_reconnect_desc"
                            android:textColor="@color/text_subtitle"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchBtAutoReconnect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"/>
                </LinearLayout>

                <!-- 4b. Bluetooth Disconnect Stop -->
                <LinearLayout
                    android:id="@+id/layoutBtDisconnectStop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_item_middle"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bt_disconnect_stop_title"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bt_disconnect_stop_desc"
                            android:textColor="@color/text_subtitle"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchBtDisconnectStop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"/>
                </LinearLayout>

                <!-- 5. WiFi Network -->
                <LinearLayout
                    android:id="@+id/layoutWifiNetwork"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_item_middle"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wifi_connected_network"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="normal"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvWifiNetworkValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/not_set"
                        android:textColor="@color/text_subtitle"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- 6. Language -->
                <LinearLayout
                    android:id="@+id/layoutLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_item_bottom"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/language_label"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="normal"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvLanguageValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/language_system_default"
                        android:textColor="@color/text_subtitle"
                        android:textSize="14sp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- INFO Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/category_info"
                android:textColor="@color/brand_teal"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"/>

            <!-- Info List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <!-- Version -->
                <LinearLayout
                    android:id="@+id/layoutVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_item_top">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/version"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="normal"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvVersionValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0.1.0"
                        android:textColor="@color/text_subtitle"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- Export Log -->
                <LinearLayout
                    android:id="@+id/layoutExportLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_item_middle"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/logs_label"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="normal"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/export_log_description"
                        android:textColor="@color/text_subtitle"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- About & Support -->
                <LinearLayout
                    android:id="@+id/layoutAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_item_bottom"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="normal"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_description"
                        android:textColor="@color/text_subtitle"
                        android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
